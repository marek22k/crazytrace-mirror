name = "crazytrace"
version = "1.0.8"
origin = "net/crazytrace"
comment = "a network simulation program"
desc = <<EOD
Simple network simulator to test ping and traceroute implementations
What happens if a traceroute with the same TTL/hop limit is received from two different source addresses? How will they react?
crazytrace is a network simulation program that can be used to see how different ping and traceroute implementations react when the sender address is different than expected.
EOD
maintainer = "m.k@mk16.de"
www = "https://codeberg.org/mark22k/crazytrace"
prefix = "/usr/local"

deps {
    yaml-cpp: {origin: "devel/yaml-cpp", version: "0.9.0"}
    boost-libs: {origin: "devel/boost-libs", version: "1.89.0_2"}
}

files {
    /usr/local/bin/crazytrace = "0755";
}
